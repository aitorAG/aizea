---
import '../styles/global.css';

type Locale = 'es' | 'en';
const locale = Astro.props.locale as Locale;
const route = Astro.props.route as 'root' | Locale | undefined;
const base = import.meta.env.BASE_URL;
const hash = Astro.url.hash;
const pathFor = (language: Locale) => language === 'es' ? `${base}es/${hash}` : `${base}${language}/${hash}`;
const canonicalPath = locale === 'es' && route !== 'es' ? `${base}` : `${base}${locale}/`;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const spanishUrl = new URL(`${base}es/`, Astro.site ?? Astro.url);
const englishUrl = new URL(`${base}en/`, Astro.site ?? Astro.url);
const defaultUrl = new URL(base, Astro.site ?? Astro.url);

const content = {
  es: {
    title: 'AIZEA — Del documento a la comprensión',
    description: 'AIZEA identifica temas y subtemas en PDFs, organiza un árbol de contenidos editable y genera diapositivas de explicación y ejercicios exportables a PPT, HTML y PDF.',
    ogTitle: 'AIZEA — Del material fuente a una estructura que se puede enseñar',
    ogDescription: 'Inspecciona y edita la estructura extraída de un documento, genera explicaciones y ejercicios, y exporta el material.',
     navLabel: 'Navegación principal', homeLabel: 'AIZEA, inicio', nav: ['Flujo', 'Capturas reales', 'Arquitectura', 'Privacidad'], viewFlow: 'Ver el flujo', repo: 'Repositorio',
    eyebrow: 'Escritorio · local-first · Tauri', heroTitle: 'Del material fuente', heroEm: 'a una estructura que se puede enseñar.', heroLede: 'AIZEA identifica automáticamente los temas y subtemas de un PDF, construye un árbol de contenidos editable y genera diapositivas de explicación y ejercicios listas para revisar y exportar.', explore: 'Explorar el flujo', editable: 'Ver el árbol editable',
    artLabel: 'PDF, temas y subtemas identificados, árbol de contenidos editable, diapositivas de explicación y ejercicios, exportación a PPT, HTML y PDF', material: 'MATERIAL · 01', cell: 'La célula', source: 'PDF / documento fuente', identify: 'identificar', topics: 'TEMAS · SUBTEMAS', membrane: 'Membrana', nucleus: 'Núcleo', energy: 'Energía', tree: 'árbol editable', generate: 'generar', explanationExercise: 'EXPLICACIÓN + EJERCICIO', system: 'La célula', system2: 'como sistema', slideMeta: 'editable · PPT · HTML · PDF',
     captureIndex: '01 / AIZEA EN FUNCIONAMIENTO', captureTitle: 'Del PDF técnico a una clase estructurada.', captureIntro: 'Un recorrido por la aplicación con un documento sobre lubricación: material fuente, temas y subtemas, árbol editable, diapositivas y exportación. Las capturas muestran resultados derivados revisados; el PDF fuente no se publica.', captureCaptions: ['1. Material técnico cargado','2. Temas y subtemas organizados en el árbol','3. Secuencia de seis diapositivas','4. Explicación: fricción, desgaste y calor','5. Ejercicio: régimen de lubricación','6. Exportación del material docente'],
     whyIndex: '02 / POR QUÉ AIZEA', whyTitle: 'Lo difícil no es tener información.', whyEm: 'Es convertirla en una estructura que puedas enseñar.', whyText: 'AIZEA identifica los temas y subtemas de un documento, hace visibles sus relaciones y deja el árbol de contenidos editable. Después crea diapositivas de explicación y ejercicios que puedes revisar, adaptar y exportar.',
     flowIndex: '03 / EL FLUJO', flowTitle: 'Una cadena de transformación', flowEm: 'que puedes inspeccionar.', flowText: 'Un documento se convierte en una secuencia revisable: identificar la estructura, editar el árbol, generar material docente y exportar el resultado. Cada etapa deja una salida que puedes revisar antes de continuar.',
    stages: [['Ingesta','El PDF entra en el escritorio. Docling preserva layout y figuras; el fallback de texto mantiene el flujo cuando hace falta.','PDF → texto estructurado'],['Identificación','AIZEA detecta automáticamente los temas y subtemas, agrupa ideas relacionadas y convierte las páginas en relaciones revisables.','Temas · subtemas · relaciones'],['Edición','Revisa el árbol de contenidos, mueve o renombra nodos, completa huecos y ajusta la estructura a tu intención docente.','Árbol de contenidos editable'],['Enseñanza y exportación','Genera diapositivas de explicación y ejercicios a partir del árbol revisado. Edita el material y expórtalo a PPT, HTML o PDF.','Explicaciones · ejercicios · PPT / HTML / PDF']],
     productIndex: '04 / REPRESENTACIÓN DEL FLUJO', productTitle: 'El proceso, de un vistazo.', productEm: 'Esquemas conceptuales.', productIntro: 'Estos diagramas resumen las etapas del producto; las capturas reales aparecen al inicio de la página.', treeLabel: 'Árbol de contenidos', course: 'Curso: Biología', biology: ['La célula','Genética','Evolución'], branches: ['Membrana celular','Núcleo','Metabolismo'], talk: '+ conversar con el árbol', identified: 'Temas y subtemas identificados', identifiedText: 'El material se organiza automáticamente en un árbol navegable que puedes mover, renombrar y editar.', explanation: 'Explicación', biologyExplanation: 'BIOLOGÍA · EXPLICACIÓN', generated: 'generada · editable', explanationTitle: 'Diapositivas de explicación', explanationText: 'Construye una explicación clara desde el árbol y revisa su redacción y secuencia.', exercise: 'Ejercicio', biologyExercise: 'BIOLOGÍA · EJERCICIO', check: 'Comprueba', learned: 'lo aprendido', guide: 'editable · guía de respuesta', exerciseTitle: 'Diapositivas de ejercicios', exerciseText: 'Añade práctica junto a la explicación para activar el aprendizaje.', resultIndex: '05 / EL RESULTADO', resultTitle: 'Tu estructura sigue siendo editable', resultEm: 'hasta el formato que necesitas.', resultText: 'Revisa el árbol y las diapositivas, adapta el material y expórtalo como presentación o documento.',
     boundaryIndex: '05 / EL LÍMITE', boundaryTitle: 'Tus documentos se quedan', boundaryEm: 'en tu máquina.', boundaryText: 'La base de datos, los archivos y el índice vectorial viven localmente. La única frontera externa es la llamada al modelo, a través de OpenRouter y con tu propia clave.', boundaryLabel: 'Diagrama textual: datos locales dentro del escritorio y OpenRouter como única frontera externa', desktop: 'EN TU ESCRITORIO', files: 'PDFs y figuras', db: 'SQLite · LanceDB', pipeline: 'Pipeline persistente', shell: 'Shell Tauri', onlyGeneration: 'solo generación', external: 'FRONTERA EXTERNA', languageModel: 'modelo de lenguaje',
     archIndex: '06 / CÓMO ESTÁ HECHO', archTitle: 'Una arquitectura', archEm: 'que explica sus límites.', archText: 'La interfaz muestra el trabajo del sistema sin ocultarlo. Activa cada capa para ver qué responsabilidad tiene y qué no hace.', layers: [['Interfaz','árbol · slides · edición','La capa que ves: superficies para navegar, revisar y editar el conocimiento.'],['Aplicación','pipeline · casos de uso','Orquesta las etapas y conserva el estado para que el trabajo pueda reanudarse.'],['Infraestructura','SQLite · LanceDB · OpenRouter','Implementa persistencia, búsqueda semántica y la única integración externa.'],['Shell','Tauri · escritorio','Empaqueta la experiencia como aplicación nativa, sin depender de un servidor público.']], fallbackLabel: 'Ver la explicación en texto', fallback: 'Entrada PDF → pipeline persistente → árbol conceptual y LanceDB RAG → edición conversacional → diapositivas editables → exportación PDF/HTML. La aplicación vive dentro de un shell Tauri; OpenRouter queda en el límite externo para las tareas de lenguaje.', footer: 'Conocimiento estructurado, sin perder el contexto.', copyright: '© AIZEA · Sitio informativo'
  },
  en: {
    title: 'AIZEA — From document to understanding',
    description: 'AIZEA identifies topics and subtopics in PDFs, organizes an editable content tree, and generates explanation and exercise slides exportable to PPT, HTML, and PDF.',
    ogTitle: 'AIZEA — From source material to a structure you can teach',
    ogDescription: 'Inspect and edit the structure extracted from a document, generate explanations and exercises, and export the material.',
     navLabel: 'Main navigation', homeLabel: 'AIZEA, home', nav: ['Workflow', 'Product screenshots', 'Architecture', 'Privacy'], viewFlow: 'View the workflow', repo: 'Repository',
    eyebrow: 'Desktop · local-first · Tauri', heroTitle: 'From source material', heroEm: 'to a structure you can teach.', heroLede: 'AIZEA automatically identifies topics and subtopics in a PDF, builds an editable content tree, and generates explanation and exercise slides ready to review and export.', explore: 'Explore the workflow', editable: 'View the editable tree',
    artLabel: 'PDF, identified topics and subtopics, editable content tree, explanation and exercise slides, export to PPT, HTML, and PDF', material: 'MATERIAL · 01', cell: 'The cell', source: 'PDF / source document', identify: 'identify', topics: 'TOPICS · SUBTOPICS', membrane: 'Membrane', nucleus: 'Nucleus', energy: 'Energy', tree: 'editable tree', generate: 'generate', explanationExercise: 'EXPLANATION + EXERCISE', system: 'The cell', system2: 'as a system', slideMeta: 'editable · PPT · HTML · PDF',
     captureIndex: '01 / AIZEA IN ACTION', captureTitle: 'From a technical PDF to a structured lesson.', captureIntro: 'A walkthrough of the app using a lubrication document: source material, extracted topics and subtopics, editable tree, slides, and export. These are reviewed screenshots of derived content; the source PDF is not published.', captureCaptions: ['1. Technical source material','2. Topics and subtopics organized in the tree','3. Six-slide sequence','4. Explanation: friction, wear, and heat','5. Exercise: lubrication regime','6. Exporting the teaching material'],
     whyIndex: '02 / WHY AIZEA', whyTitle: 'The hard part is not having information.', whyEm: 'It is turning it into a structure you can teach.', whyText: 'AIZEA identifies topics and subtopics in a document, makes their relationships visible, and leaves the content tree editable. Then it creates explanation and exercise slides you can review, adapt, and export.',
     flowIndex: '03 / THE WORKFLOW', flowTitle: 'A transformation chain', flowEm: 'you can inspect.', flowText: 'A document becomes a reviewable sequence: identify the structure, edit the tree, generate teaching material, and export the result. Each stage leaves an output you can review before moving on.',
    stages: [['Ingest','The PDF enters the desktop. Docling preserves layout and figures; the text fallback keeps the flow moving when needed.','PDF → structured text'],['Identification','AIZEA automatically detects topics and subtopics, groups related ideas, and turns pages into reviewable relationships.','Topics · subtopics · relationships'],['Editing','Review the content tree, move or rename nodes, fill gaps, and adjust the structure to your teaching intent.','Editable content tree'],['Teaching and export','Generate explanation and exercise slides from the reviewed tree. Edit the material and export it to PPT, HTML, or PDF.','Explanations · exercises · PPT / HTML / PDF']],
     productIndex: '04 / WORKFLOW REPRESENTATION', productTitle: 'The process, at a glance.', productEm: 'Conceptual diagrams.', productIntro: 'These diagrams summarize the product stages; real application screenshots appear near the top of the page.', treeLabel: 'Content tree', course: 'Course: Biology', biology: ['The cell','Genetics','Evolution'], branches: ['Cell membrane','Nucleus','Metabolism'], talk: '+ talk to the tree', identified: 'Identified topics and subtopics', identifiedText: 'The material is automatically organized into a navigable tree you can move, rename, and edit.', explanation: 'Explanation', biologyExplanation: 'BIOLOGY · EXPLANATION', generated: 'generated · editable', explanationTitle: 'Explanation slides', explanationText: 'Build a clear explanation from the tree and review its wording and sequence.', exercise: 'Exercise', biologyExercise: 'BIOLOGY · EXERCISE', check: 'Check', learned: 'what you learned', guide: 'editable · answer guide', exerciseTitle: 'Exercise slides', exerciseText: 'Add practice alongside the explanation to activate learning.', resultIndex: '05 / THE RESULT', resultTitle: 'Your structure stays editable', resultEm: 'until the format you need.', resultText: 'Review the tree and slides, adapt the material, and export it as a presentation or document.',
     boundaryIndex: '05 / THE BOUNDARY', boundaryTitle: 'Your documents stay', boundaryEm: 'on your machine.', boundaryText: 'The database, files, and vector index live locally. The only external boundary is the model call through OpenRouter, using your own key.', boundaryLabel: 'Text diagram: local data inside the desktop and OpenRouter as the only external boundary', desktop: 'ON YOUR DESKTOP', files: 'PDFs and figures', db: 'SQLite · LanceDB', pipeline: 'Persistent pipeline', shell: 'Tauri shell', onlyGeneration: 'generation only', external: 'EXTERNAL BOUNDARY', languageModel: 'language model',
     archIndex: '06 / HOW IT IS BUILT', archTitle: 'An architecture', archEm: 'that explains its limits.', archText: 'The interface shows the system at work without hiding it. Activate each layer to see what responsibility it has and what it does not do.', layers: [['Interface','tree · slides · editing','The layer you see: surfaces for navigating, reviewing, and editing knowledge.'],['Application','pipeline · use cases','Orchestrates the stages and preserves state so work can resume.'],['Infrastructure','SQLite · LanceDB · OpenRouter','Implements persistence, semantic search, and the only external integration.'],['Shell','Tauri · desktop','Packages the experience as a native application without depending on a public server.']], fallbackLabel: 'View the explanation as text', fallback: 'PDF input → persistent pipeline → conceptual tree and LanceDB RAG → conversational editing → editable slides → PDF/HTML export. The application lives inside a Tauri shell; OpenRouter sits at the external boundary for language tasks.', footer: 'Structured knowledge, without losing context.', copyright: '© AIZEA · Informational site'
  }
} as const;
const t = content[locale];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={t.description} /><meta property="og:title" content={t.ogTitle} /><meta property="og:description" content={t.ogDescription} /><meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} /><link rel="alternate" hreflang="es" href={spanishUrl} /><link rel="alternate" hreflang="en" href={englishUrl} /><link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="icon" href={`${base}favicon.svg`} /><title>{t.title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${canonicalPath}#top`} aria-label={t.homeLabel}><span class="brand-mark">A</span><span>AIZEA</span></a>
      <nav aria-label={t.navLabel}><a href="#flujo">{t.nav[0]}</a><a href="#evidencia">{t.nav[1]}</a><a href="#arquitectura">{t.nav[2]}</a><a href="#limite">{t.nav[3]}</a></nav>
      <div class="header-actions"><a class="header-link" href="#evidencia">{t.viewFlow} <span aria-hidden="true">↗</span></a><a class="header-link header-link-repo" href="https://github.com/aitorAG/aizea" target="_blank" rel="noreferrer">{t.repo} <span aria-hidden="true">↗</span></a><div class="language-switcher" aria-label={locale === 'es' ? 'Idioma' : 'Language'}><a class="language-link" href={pathFor('es')} aria-current={locale === 'es' ? 'page' : undefined}>ES</a><span aria-hidden="true">/</span><a class="language-link" href={pathFor('en')} aria-current={locale === 'en' ? 'page' : undefined}>EN</a></div></div>
    </header>
    <main id="top">
      <section class="hero section-wrap" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> {t.eyebrow}</p><h1 id="hero-title">{t.heroTitle}<br /><em>{t.heroEm}</em></h1><p class="hero-lede">{t.heroLede}</p><div class="hero-actions"><a class="button button-dark" href="#flujo">{t.explore} <span aria-hidden="true">↓</span></a><a class="text-link" href="#evidencia">{t.editable} <span aria-hidden="true">↗</span></a></div></div><div class="hero-art" aria-label={t.artLabel}><div class="paper-stack"><div class="paper"><span class="paper-label">{t.material}</span><strong>{t.cell}</strong><i></i><i></i><i></i><small>{t.source}</small></div><div class="paper paper-back"></div></div><div class="flow-line"><span>{t.identify}</span></div><div class="tree-sketch"><div class="tree-root">{t.topics}</div><div class="tree-branches"><span>{t.membrane}</span><span>{t.nucleus}</span><span>{t.energy}</span></div><div class="tree-stem"></div><small>{t.tree}</small></div><div class="flow-line"><span>{t.generate}</span></div><div class="slide-sketch"><div class="slide-top">{t.explanationExercise}</div><strong>{t.system}<br />{t.system2}</strong><div class="slide-bars"><i></i><i></i><i></i></div><small>{t.slideMeta}</small></div></div></section>
       <section id="evidencia" class="early-captures section-wrap" aria-labelledby="capture-title"><div class="capture-heading"><p class="section-index">{t.captureIndex}</p><h2 id="capture-title">{t.captureTitle}</h2><p>{t.captureIntro}</p></div><div class="capture-grid resource-capture-grid">{[['materials-source-card.png', t.captureCaptions[0]], ['conceptual-tree-lubrication.png', t.captureCaptions[1]], ['slides-overview-derived.png', t.captureCaptions[2]], ['explanation-slide-editor-preview.png', t.captureCaptions[3]], ['exercise-slide-editor-preview.png', t.captureCaptions[4]], ['export-modal-ui.png', t.captureCaptions[5]]].map(([image, caption]) => <figure><img src={`${base}screenshots/${image}`} alt={caption} loading="lazy" /><figcaption>{caption}</figcaption></figure>)}</div></section>
       <section class="statement band" aria-labelledby="statement-title"><div class="section-wrap statement-grid"><p class="section-index">{t.whyIndex}</p><h2 id="statement-title">{t.whyTitle}<br /><em>{t.whyEm}</em></h2><p>{t.whyText}</p></div></section>
      <section id="flujo" class="section-wrap workflow" aria-labelledby="flow-title"><div class="section-heading"><p class="section-index">{t.flowIndex}</p><h2 id="flow-title">{t.flowTitle}<br /><em>{t.flowEm}</em></h2><p>{t.flowText}</p></div><ol class="stage-list">{t.stages.map((stage, index) => <li><span class="stage-number">{String(index + 1).padStart(2, '0')}</span><div><h3>{stage[0]}</h3><p>{stage[1]}</p><span class="stage-tag">{stage[2]}</span></div></li>)}</ol></section>
      <section id="evidencia" class="evidence band" aria-labelledby="evidence-title"><div class="section-wrap"><div class="section-heading evidence-heading"><p class="section-index">{t.productIndex}</p><h2 id="evidence-title">{t.productTitle}<br /><em>{t.productEm}</em></h2><p>{t.productIntro}</p></div><div class="product-views"><article class="product-view tree-view"><div class="view-chrome"><span>AIZEA / {t.treeLabel}</span><span>○ ○ ○</span></div><div class="view-body"><div class="view-side"><b>{t.course}</b>{t.biology.map((item, index) => <span>0{index + 1} {item}</span>)}</div><div class="mini-tree"><b>{t.cell}</b>{t.branches.map((item, index) => <span>{index === 2 ? '└─' : '├─'} {item}</span>)}<i>{t.talk}</i></div></div><h3>{t.identified}</h3><p>{t.identifiedText}</p></article><article class="product-view slide-view"><div class="view-chrome"><span>AIZEA / {t.explanation}</span><span>1 / 12</span></div><div class="slide-large"><small>{t.biologyExplanation}</small><strong>{t.system}<br />{t.system2}</strong><div></div><span>{t.generated}</span></div><h3>{t.explanationTitle}</h3><p>{t.explanationText}</p></article><article class="product-view slide-view exercise-view"><div class="view-chrome"><span>AIZEA / {t.exercise}</span><span>2 / 12</span></div><div class="slide-large"><small>{t.biologyExercise}</small><strong>{t.check}<br />{t.learned}</strong><div></div><span>{t.guide}</span></div><h3>{t.exerciseTitle}</h3><p>{t.exerciseText}</p></article></div><div class="app-captures"><div class="capture-heading"><p class="section-index">{locale === 'es' ? 'CAPTURAS DE LA APP' : 'APP SCREENSHOTS'}</p><h3>{locale === 'es' ? 'Del PDF técnico a material docente.' : 'From technical PDF to teaching material.'}</h3><p>{locale === 'es' ? 'Estas capturas muestran una ejecución de la aplicación con el material técnico de lubricación: material fuente, árbol de 12 nodos, seis diapositivas, ejercicios y exportación. La captura usa un entorno aislado y contenido derivado revisado para publicación.' : 'These screenshots show the application running with technical lubrication material: source material, a 12-node tree, six slides, exercises, and export. The capture uses an isolated environment and reviewed derived content.'}</p></div><div class="capture-grid resource-capture-grid"><figure><img src={`${base}screenshots/materials-source-card.png`} alt={locale === 'es' ? 'Pantalla de materiales de AIZEA con un recurso técnico de lubricación' : 'AIZEA materials screen with a technical lubrication resource'} loading="lazy" /><figcaption>{locale === 'es' ? 'Material fuente · recurso técnico' : 'Source material · technical resource'}</figcaption></figure><figure><img src={`${base}screenshots/conceptual-tree-lubrication.png`} alt={locale === 'es' ? 'Árbol conceptual de AIZEA con temas de lubricación, fluidos, fricción y cojinetes' : 'AIZEA conceptual tree with lubrication, fluid, friction, and bearing topics'} loading="lazy" /><figcaption>{locale === 'es' ? 'Temas y subtemas identificados' : 'Identified topics and subtopics'}</figcaption></figure><figure><img src={`${base}screenshots/slides-overview-derived.png`} alt={locale === 'es' ? 'Vista de AIZEA con seis diapositivas derivadas sobre lubricación' : 'AIZEA view with six derived lubrication slides'} loading="lazy" /><figcaption>{locale === 'es' ? 'Secuencia de diapositivas derivada' : 'Derived slide sequence'}</figcaption></figure><figure><img src={`${base}screenshots/explanation-slide-editor-preview.png`} alt={locale === 'es' ? 'Editor de AIZEA con preview legible de una diapositiva sobre fricción, desgaste y calor' : 'AIZEA editor with a readable preview slide about friction, wear, and heat'} loading="lazy" /><figcaption>{locale === 'es' ? 'Explicación · fricción, desgaste y calor' : 'Explanation · friction, wear, and heat'}</figcaption></figure><figure><img src={`${base}screenshots/exercise-slide-editor-preview.png`} alt={locale === 'es' ? 'Editor de AIZEA con un ejercicio sobre película completa y régimen de lubricación' : 'AIZEA editor with an exercise about full film and lubrication regime'} loading="lazy" /><figcaption>{locale === 'es' ? 'Ejercicio · régimen de lubricación' : 'Exercise · lubrication regime'}</figcaption></figure><figure><img src={`${base}screenshots/export-modal-ui.png`} alt={locale === 'es' ? 'Modal de AIZEA para exportar el material docente derivado' : 'AIZEA modal for exporting the derived teaching material'} loading="lazy" /><figcaption>{locale === 'es' ? 'Exportación del material docente' : 'Teaching material export'}</figcaption></figure></div></div><div class="export-strip"><p class="section-index">{t.resultIndex}</p><h3>{t.resultTitle} <em>{t.resultEm}</em></h3><p>{t.resultText}</p><div class="export-formats"><span>PPT</span><span>HTML</span><span>PDF</span></div></div></div></section>
      <section id="limite" class="section-wrap boundary" aria-labelledby="boundary-title"><div class="boundary-copy"><p class="section-index">{t.boundaryIndex}</p><h2 id="boundary-title">{t.boundaryTitle}<br /><em>{t.boundaryEm}</em></h2><p>{t.boundaryText}</p></div><div class="boundary-diagram" role="img" aria-label={t.boundaryLabel}><div class="local-box"><b>{t.desktop}</b><span>{t.files}</span><span>{t.db}</span><span>{t.pipeline}</span><span>{t.shell}</span></div><div class="boundary-arrow"><span>{t.onlyGeneration}</span> →</div><div class="external-box"><b>{t.external}</b><span>OpenRouter</span><small>{t.languageModel}</small></div></div></section>
      <section id="arquitectura" class="architecture band" aria-labelledby="architecture-title"><div class="section-wrap architecture-grid"><div><p class="section-index">{t.archIndex}</p><h2 id="architecture-title">{t.archTitle}<br /><em>{t.archEm}</em></h2><p>{t.archText}</p></div><div class="layers" data-layers>{t.layers.map((layer, index) => <><button class:list={['layer', { active: index === 0 }]} type="button" aria-expanded={index === 0 ? 'true' : 'false'}><span>0{index + 1}</span><b>{layer[0]}</b><i>{layer[1]}</i></button><div class="layer-detail" hidden={index !== 0}>{layer[2]}</div></>)}</div></div><div class="diagram-fallback section-wrap"><details><summary>{t.fallbackLabel}</summary><p>{t.fallback}</p></details></div></section>
    </main>
    <footer class="site-footer section-wrap"><a class="brand" href={`${canonicalPath}#top`}><span class="brand-mark">A</span><span>AIZEA</span></a><p>{t.footer}</p><span>{t.copyright}</span></footer>
     <script>document.querySelectorAll('[data-layers] .layer').forEach((button) => { button.addEventListener('click', () => { const layers = button.parentElement; if (!layers) return; layers.querySelectorAll('.layer').forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-expanded', String(active)); const detail = item.nextElementSibling; if (detail instanceof HTMLElement) detail.hidden = !active; }); }); }); document.querySelectorAll<HTMLAnchorElement>('.language-link').forEach((link) => { link.addEventListener('click', (event) => { if (!window.location.hash) return; event.preventDefault(); window.location.assign(`${link.href}${window.location.hash}`); }); });</script>
  </body>
</html>
