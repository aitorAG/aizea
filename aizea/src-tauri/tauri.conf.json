{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIzea",
  "version": "0.3.0",
  "identifier": "com.aizea.app",
  "build": {
    "frontendDist": "../.next/standalone/public",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "pnpm dev --port 3001"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIzea",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "http://localhost:1422"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "AIzea",
    "category": "Education",
    "externalBin": ["binaries/node"],
    "resources": {
      "../.next/standalone": "standalone"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
