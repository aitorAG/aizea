# === OPENROUTER ===
# Tu API key de OpenRouter (https://openrouter.ai/settings/keys)
# También configurable en la app en /settings
OPENROUTER_API_KEY=

# Modelo LLM por defecto (opcional, se puede cambiar en /settings)
OPENROUTER_MODEL=deepseek/deepseek-chat

# === DOCLING (opcional) ===
# URL del servidor Docling para parsing avanzado de PDFs
# Si no se configura, la app usa parsing básico (text-only)
# Arrancar Docling con: pnpm docling:up
DOCLING_BASE_URL=http://127.0.0.1:5001

# === DATABASE ===
# Optional explicit SQLite override for tests/CI. Normal local use defaults
# to prisma/dev.db and desktop always uses AIZEA_DATA_DIR/db.sqlite.
DATABASE_URL="file:./dev.db"

