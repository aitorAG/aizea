{
  "name": "aizea",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "local": "node scripts/start-local.cjs",
    "build:msi": "node scripts/build-msi.cjs",
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "dev:restart": "powershell -Command \"Get-NetTCPConnection -LocalPort 3100 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }; Start-Sleep -Seconds 2; pnpm dev --port 3100\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "docling:up": "docker compose up -d docling-serve",
    "docling:down": "docker compose down docling-serve",
    "docling:logs": "docker compose logs -f docling-serve",
    "docling:check": "node scripts/check-docling.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lancedb/lancedb": "^0.31.0",
    "@prisma/client": "~6.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@types/dagre": "^0.7.54",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "katex": "^0.16.11",
    "lucide-react": "^0.400.0",
    "next": "^15.2.0",
    "next-pwa": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "~6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
