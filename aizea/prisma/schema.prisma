generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id                     String          @id @default(uuid())
  name                   String
  llmContext             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  slideTarget            Int?
  generationInstructions String?
  figures                Figure[]
  materials              Material[]
  processingJobs         ProcessingJob[]
  slides                 Slide[]
  topicGroups            TopicGroup[]
  topicNodes             TopicNode[]
}

model Material {
  id            String         @id @default(uuid())
  courseId      String
  filename      String
  /// @deprecated Use TextChunk for chunked access
  content       String
  pageCount     Int            @default(0)
  fileSize      Int?
  fileType      String?
  createdAt     DateTime       @default(now())
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semanticUnits SemanticUnit[]
  chunks        TextChunk[]

  @@index([courseId, createdAt])
}

model Slide {
  id            String     @id @default(uuid())
  courseId      String
  title         String
  description   String
  order         Int        @default(0)
  numericPath   String?
  displayOrder  Int?
  figureRefs    String     @default("[]")
  htmlDesign    String?
  kind          String     @default("concept")
  status        String     @default("PENDING")
  parentSlideId String?
  sourceNodeId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parentSlide   Slide?     @relation("SlideTree", fields: [parentSlideId], references: [id])
  childSlides   Slide[]    @relation("SlideTree")
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  boxes         SlideBox[]

  @@index([courseId, order])
  @@index([courseId, displayOrder])
  @@index([courseId, status])
  @@index([courseId, parentSlideId])
  @@index([sourceNodeId])
}

model SlideBox {
  id      String @id @default(uuid())
  slideId String
  type    String
  content String
  slide   Slide  @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@index([slideId, type])
}

model TextChunk {
  id         String   @id @default(uuid())
  materialId String
  chunkIndex Int
  content    String
  embedding  String?
  tokenCount Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, chunkIndex])
}

model Figure {
  id        String   @id @default(uuid())
  courseId  String
  filename  String
  caption   String?
  pageNum   Int?
  tags      String   @default("[]")
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model SemanticUnit {
  id             String              @id @default(uuid())
  materialId     String
  content        String
  order          Int
  pageStart      Int?
  pageEnd        Int?
  sectionRef     String?
  createdAt      DateTime            @default(now())
  /// PR2 — breadcrumb of heading titles from the document root to this unit's
  /// section, JSON-encoded (e.g. ["Cap 3","3.2 Termodinámica"]). Empty "[]"
  /// when docling gave no structure (text-only fallback). Feeds the tree
  /// skeleton so the LLM refines a real hierarchy instead of inventing one.
  sectionPath    String              @default("[]")
  material       Material            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  representation UnitRepresentation?

  @@index([materialId, order])
}

model UnitRepresentation {
  id            String       @id @default(uuid())
  unitId        String       @unique
  concepts      String       @default("[]")
  mainIdeas     String       @default("[]")
  formulas      String       @default("[]")
  figures       String       @default("[]")
  prerequisites String       @default("[]")
  introduces    String       @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  unit          SemanticUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model TopicNode {
  id                String      @id @default(uuid())
  courseId          String
  parentId          String?
  name              String
  summary           String?
  depth             Int         @default(0)
  orderIndex        Int         @default(0)
  numericPath       String?
  displayOrder      Int?
  sourceMaterialIds String      @default("[]")
  isLeaf            Boolean     @default(false)
  version           Int         @default(1)
  sourceMaterialId  String?
  pageStart         Int?
  pageEnd           Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  parent            TopicNode?  @relation("TopicTree", fields: [parentId], references: [id])
  children          TopicNode[] @relation("TopicTree")
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, parentId])
  @@index([courseId, version])
  @@index([courseId, isLeaf])
  @@index([courseId, displayOrder])
}

model TopicGroup {
  id            String   @id @default(uuid())
  courseId      String
  name          String
  description   String
  importance    Float    @default(0.5)
  concepts      String   @default("[]")
  sourceUnitIds String   @default("[]")
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, version])
}

model Settings {
  id               String   @id @default("default")
  openrouterApiKey String?
  chatModel        String   @default("deepseek/deepseek-chat")
  embedModel       String   @default("openai/text-embedding-3-small")
  doclingBaseUrl   String   @default("http://127.0.0.1:5001")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProcessingJob {
  id          String   @id
  type        String
  status      String
  progress    Int      @default(0)
  total       Int      @default(100)
  currentStep String?
  error       String?
  courseId    String?
  materialId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([courseId, createdAt])
  @@index([status, updatedAt])
}
